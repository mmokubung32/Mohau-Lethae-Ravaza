# Copy this file to .env and fill in real values before running.
# Never commit the real .env file — see docs/SECURITY.md.

PORT=4000
NODE_ENV=development

# Where the frontend is served from, for CORS. In production this is your real domain.
PUBLIC_SITE_ORIGIN=http://localhost:8000

# Local SQLite file for this runnable demo backend.
# In production, this file is replaced by a Postgres connection managed
# through Prisma — see docs/ARCHITECTURE.md and docs/DATABASE.md.
DATABASE_PATH=./data/mohau.db

# Long, random string — used to sign admin session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account, created by `npm run seed`.
ADMIN_EMAIL=studio@mohaulethae.art
ADMIN_PASSWORD=

# Not used yet (Phase 11 in docs/BACKEND-ROADMAP.md) — placeholder so the
# shape of production config is visible now.
EMAIL_PROVIDER_API_KEY=
STUDIO_NOTIFICATION_EMAIL=
STUDIO_FROM_EMAIL=

# PayFast — sandbox test credentials are used automatically if these are left
# blank (see src/lib/payfast.js). Set PAYFAST_MODE=live and fill in your real
# merchant details only when going live.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# The publicly reachable origin PayFast should call back to with payment
# notifications. In local development this can't actually be reached by
# PayFast's real servers — see docs/DEPLOYMENT.md and the note at the top of
# src/routes/payments.js. Use a tool like ngrok for local end-to-end testing,
# or your real deployed API URL in production.
PUBLIC_API_ORIGIN=http://localhost:4000
